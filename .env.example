# --- Postgres ---
POSTGRES_USER=triage
POSTGRES_PASSWORD=triage
POSTGRES_DB=triage
DATABASE_URL=postgresql+psycopg://triage:triage@postgres:5432/triage

# --- Redis / queue ---
REDIS_URL=redis://redis:6379/0

# --- LLM ---
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here
# claude-sonnet-5 is a good default. claude-haiku-4-5-20251001 is cheaper/faster
# for high volume; claude-opus-5 if you want the most thorough reasoning.
ANTHROPIC_MODEL=claude-sonnet-5

# --- GitHub ---
# Fine-grained PAT with "Actions: Read" on the repos you want to triage.
# For multi-repo/org use, swap this for a GitHub App installation token later.
GITHUB_TOKEN=ghp_your_token_here
# Set this to the same secret you configure on the GitHub webhook.
GITHUB_WEBHOOK_SECRET=change-me

# --- API / frontend ---
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8000
